[
  {
    "name": "Summarize what is drawn",
    "messages": [{ "role": "user", "type": "message", "content": "What is on this canvas right now?" }],
    "expectedCall": [{ "functionName": "get_canvas_summary", "arguments": {} }]
  },
  {
    "name": "Inspect current drawing",
    "messages": [{ "role": "user", "type": "message", "content": "Inspect the current drawing and tell me which elements it contains." }],
    "expectedCall": [{ "functionName": "get_canvas_summary", "arguments": {} }]
  },
  {
    "name": "Read selected elements",
    "messages": [{ "role": "user", "type": "message", "content": "Which elements do I currently have selected?" }],
    "expectedCall": [{ "functionName": "get_selection", "arguments": {} }]
  },
  {
    "name": "Inspect my selection",
    "messages": [{ "role": "user", "type": "message", "content": "Read my current canvas selection." }],
    "expectedCall": [{ "functionName": "get_selection", "arguments": {} }]
  },
  {
    "name": "Read before adding labeled rectangle",
    "messages": [{ "role": "user", "type": "message", "content": "Add a blue rectangle labeled Browser to the canvas." }],
    "expectedCall": [{ "functionName": "get_canvas_summary", "arguments": {} }]
  },
  {
    "name": "Add labeled rectangle after read",
    "messages": [
      { "role": "user", "type": "message", "content": "Add a blue rectangle labeled Browser to the canvas." },
      { "role": "model", "type": "functioncall", "name": "get_canvas_summary", "arguments": {} },
      { "role": "user", "type": "functionresponse", "name": "get_canvas_summary", "response": { "ok": true, "revision": 0, "element_count": 0, "elements": [] } },
      { "role": "user", "type": "message", "content": "The canvas is empty at revision 0. Add the requested Browser rectangle now." }
    ],
    "expectedCall": [
      {
        "functionName": "add_elements",
        "arguments": {
          "elements": [
            {
              "id": { "$type": "string" },
              "type": "rectangle",
              "x": { "$type": "number" },
              "y": { "$type": "number" },
              "width": { "$type": "number" },
              "height": { "$type": "number" },
              "label": { "text": "Browser" }
            }
          ]
        }
      }
    ]
  },
  {
    "name": "Update known node after selection confirmation",
    "messages": [
      { "role": "user", "type": "message", "content": "Move node_1 to x 300 and y 180." },
      { "role": "model", "type": "functioncall", "name": "get_selection", "arguments": {} },
      { "role": "user", "type": "functionresponse", "name": "get_selection", "response": { "ok": true, "revision": 4, "selected_count": 1, "elements": [{ "id": "node_1", "type": "rectangle", "x": 100, "y": 100, "width": 180, "height": 90 }] } },
      { "role": "user", "type": "message", "content": "node_1 is confirmed at revision 4. Perform the requested move now without another read." }
    ],
    "expectedCall": [
      {
        "functionName": "update_elements",
        "arguments": {
          "expected_revision": 4,
          "patches": [{ "id": "node_1", "changes": { "x": 300, "y": 180 } }]
        }
      }
    ]
  },
  {
    "name": "Delete known node",
    "messages": [{ "role": "user", "type": "message", "content": "Delete the canvas element whose ID is obsolete_node." }],
    "expectedCall": [{ "functionName": "delete_elements", "arguments": { "ids": ["obsolete_node"] } }]
  },
  {
    "name": "Fit entire drawing",
    "messages": [{ "role": "user", "type": "message", "content": "Fit the whole drawing into view." }],
    "expectedCall": [{ "functionName": "fit_to_content", "arguments": { "scope": "all" } }]
  },
  {
    "name": "Fit current selection",
    "messages": [{ "role": "user", "type": "message", "content": "Focus the viewport on the elements I selected." }],
    "expectedCall": [{ "functionName": "fit_to_content", "arguments": { "scope": "selection" } }]
  },
  {
    "name": "Organize horizontal flow",
    "messages": [{ "role": "user", "type": "message", "content": "Arrange all supported nodes horizontally with 80 pixels between them." }],
    "expectedCall": [
      {
        "functionName": "organize_diagram",
        "arguments": { "scope": "all", "layout": "horizontal", "spacing": 80 }
      }
    ]
  }
]
