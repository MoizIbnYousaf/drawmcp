    {
      "name": "delete_elements",
      "description": "Delete current elements by stable ID as one undoable action.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ids"
        ],
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 0
          },
          "ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          }
        }
      }
