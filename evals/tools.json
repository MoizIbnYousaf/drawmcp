    {
      "name": "fit_to_content",
      "description": "Move the visible viewport to the current selection or all canvas elements.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope"
        ],
        "properties": {
          "scope": {
            "enum": [
              "selection",
              "all"
            ]
          },
          "animate": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "organize_diagram",
      "description": "Arrange supported current nodes with a deterministic local layout as one undoable action.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope",
          "layout"
        ],
        "properties": {
          "expected_revision": {
