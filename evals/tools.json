              "selection",
              "all"
            ]
          },
          "layout": {
            "enum": [
              "horizontal",
              "vertical",
              "grid"
            ]
          },
          "spacing": {
            "type": "number",
            "minimum": 20,
            "maximum": 500
          }
        }
      }
