{
  "name": "drawmcp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src evals/oracles benchmarks scripts/evals scripts/benchmarks vite.config.ts vitest.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "evals:export": "npx -y tsx@4.23.13 scripts/export-eval-fixtures.ts",
    "evals:check": "npm run evals:export && git diff --exit-code -- evals/tools.json",
    "evals:smoke:local": "webmcp-evals smoke -u http://127.0.0.1:5173/canvas -e evals/webmcp-evals.json --chrome-channel chrome -v",
    "evals:deterministic": "npx -y tsx@4.23.13 scripts/evals/run-deterministic.ts",
    "evals:deterministic:production": "npx -y tsx@4.23.13 scripts/evals/run-deterministic.ts --url https://drawmcp.dev/canvas",
    "evals:schema": "npx -y tsx@4.23.13 scripts/evals/export-model-schema.ts",
    "evals:probabilistic": "npx -y tsx@4.23.13 scripts/evals/run-probabilistic.ts",
    "evals:accept": "npx -y tsx@4.23.13 scripts/evals/accept-probabilistic.ts",
    "benchmark:prepare": "pnpm --dir vendor/excalidraw-mcp install --frozen-lockfile && pnpm --dir vendor/excalidraw-mcp run build",
    "benchmark:run": "npm run benchmark:prepare && npx -y tsx@4.23.13 scripts/benchmarks/run-paired.ts",
    "benchmark:verify": "npx -y tsx@4.23.13 scripts/benchmarks/verify-run.ts",
    "benchmark:accept": "npx -y tsx@4.23.13 scripts/benchmarks/accept-run.ts",
    "video:check": "npm --prefix video/comparison run check",
    "preview": "vite preview"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "ajv": "8.20.0",
    "drawably": "0.3.10",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "^24.13.3",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "30.0.1",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "4.1.11",
    "webmcp-evals": "0.0.4"
  },
  "overrides": {
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16"
    },
    "lodash-es": "4.18.1",
    "nanoid": "3.3.18"
  }
}
